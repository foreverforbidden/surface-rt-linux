# Additions for rt (Raspbian 11 on the Surface RT), on top of linux-surface-rt's config.
# systemd uses autofs for its automount units.
CONFIG_AUTOFS_FS=y
# rt's 5.17 kernel had this Spectre v2 mitigation for the Cortex-A9 enabled.
CONFIG_HARDEN_BRANCH_PREDICTOR=y
# Raspbian 11's kmod 28 is built without zstd (kmod --version shows -ZSTD), so it can't load
# .ko.zst modules, Wi-Fi included. Install them uncompressed.
# CONFIG_MODULE_COMPRESS is not set
