[binaries]
c = 'arm-linux-gnueabihf-gcc'
cpp = 'arm-linux-gnueabihf-g++'
ar = 'arm-linux-gnueabihf-ar'
strip = 'arm-linux-gnueabihf-strip'
pkg-config = 'arm-linux-gnueabihf-pkg-config'

[host_machine]
system = 'linux'
cpu_family = 'arm'
cpu = 'cortex-a9'
endian = 'little'

[built-in options]
c_args = ['-mcpu=cortex-a9', '-mfpu=neon', '-mfloat-abi=hard']
cpp_args = ['-mcpu=cortex-a9', '-mfpu=neon', '-mfloat-abi=hard']
