+
+/* move/resize the video inside the display (kmssink on a DRM overlay plane), so the
+ * dashboard's control bar can be uncovered. w = h = -1 restores the full display. */
+void video_renderer_set_render_rectangle(int x, int y, int w, int h) {
+    for (int i = 0; i < n_renderers; i++) {
+        if (!renderer_type[i] || !renderer_type[i]->pipeline) continue;
+        GstElement *sink = gst_bin_get_by_interface(GST_BIN(renderer_type[i]->pipeline),
+                                                    GST_TYPE_VIDEO_OVERLAY);
+        if (!sink) continue;
+        gst_video_overlay_set_render_rectangle(GST_VIDEO_OVERLAY(sink), x, y, w, h);
+        gst_video_overlay_expose(GST_VIDEO_OVERLAY(sink));
+        gst_object_unref(sink);
+    }
 }
 
