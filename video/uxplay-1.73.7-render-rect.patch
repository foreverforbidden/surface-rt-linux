@@ -611,6 +611,18 @@
     return TRUE;
 }
 
+#ifndef _WIN32
+static gboolean render_rect_callback(gpointer env_name) {
+    const char *spec = getenv((const char *) env_name);
+    int x = 0, y = 0, w = -1, h = -1;
+    if (!spec || sscanf(spec, "%d,%d,%d,%d", &x, &y, &w, &h) != 4) {
+        x = y = 0; w = h = -1;
+    }
+    video_renderer_set_render_rectangle(x, y, w, h);
+    return G_SOURCE_CONTINUE;
+}
+#endif
+
 static gboolean sigterm_callback(gpointer loop) {
     relaunch_video = false;
     g_main_loop_quit((GMainLoop *) loop);
@@ -728,6 +740,15 @@
     guint sigterm_watch_id = g_unix_signal_add(SIGTERM, (GSourceFunc) sigterm_callback, (gpointer) loop);
     guint sigint_watch_id = g_unix_signal_add(SIGINT, (GSourceFunc) sigint_callback, (gpointer) loop);
     guint sighup_watch_id = g_unix_signal_add(SIGHUP, (GSourceFunc) sigint_callback, (gpointer) loop);
+    /* SIGUSR1/SIGUSR2 set the video render rectangle from $UXPLAY_RECT_SIGUSR1/2
+     * ("x,y,w,h"; unset = full display). Registered once on the default context and never removed,
+     * so a signal between main-loop runs can't hit the default (terminating) disposition. */
+    static bool rect_signals = false;
+    if (!rect_signals) {
+        rect_signals = true;
+        g_unix_signal_add(SIGUSR1, (GSourceFunc) render_rect_callback, (gpointer) "UXPLAY_RECT_SIGUSR1");
+        g_unix_signal_add(SIGUSR2, (GSourceFunc) render_rect_callback, (gpointer) "UXPLAY_RECT_SIGUSR2");
+    }
 #endif
     g_main_loop_run(loop);
 
