# Let the video group (add the kiosk user to it) set the panel brightness without sudo.
# Install: sudo cp system/90-backlight.rules /etc/udev/rules.d/
ACTION=="add", SUBSYSTEM=="backlight", RUN+="/bin/chgrp video /sys/class/backlight/%k/brightness", RUN+="/bin/chmod g+w /sys/class/backlight/%k/brightness"
